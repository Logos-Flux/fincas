# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (PostgreSQL for production; SQLite default for dev)
DATABASE_URL=postgresql://user:password@localhost:5432/golden_erp

# Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,golden-erp.fly.dev
# Reverse proxies / server-side callers whose X-Forwarded-For is believed (IPs or CIDRs).
# Empty: per-client throttles key on REMOTE_ADDR. See core/client_ip.py.
TRUSTED_PROXIES=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://example.com

# API Key (service-to-Django auth)
API_KEY=change-me-in-production

# Production signing/encryption keys; config.settings.prod refuses to deploy
# without them (check core.E060). Generate with `python manage.py generate_secrets`.
# Unset in development: the first two derive from DJANGO_SECRET_KEY; an empty
# GOLDEN_SECRET_KEYS means no connected account can store a credential.
API_JWT_SIGNING_KEY=
LLMHUB_FERNET_KEY=
GOLDEN_SECRET_KEYS=

# Customer portal auth
PORTAL_AUTH_URL=https://your-auth-provider.example.com
PORTAL_JWT_SECRET=your-jwt-secret

# Sentry
SENTRY_DSN=

# LLM Providers for chat
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
